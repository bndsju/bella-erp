# Copie para .env e preencha. O .env nunca vai para o Git. Evite $ e # nos valores.

# Endereco do site, sem https://. Com dominio: bella.seudominio.com.br
# Sem dominio, use o IP do servidor com hifens: 203-0-113-10.sslip.io
SITE_ADDRESS=

# Gere com: openssl rand -hex 24
DB_PASSWORD=

# Gere com: openssl rand -base64 48 | tr -d '/+=\n'
JWT_SEGREDO=

# Senha do primeiro administrador (login: admin). Minimo de 10 caracteres, com letra e numero,
# sem a palavra "admin". So e usada na primeira vez que o sistema sobe, mas e exigida sempre.
ADMIN_SENHA=
